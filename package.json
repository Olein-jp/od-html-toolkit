{
  "name": "od-html-toolkit",
  "version": "0.1.3",
  "private": true,
  "description": "Local development environment for OD HTML Toolkit.",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli wp",
    "lint:php": "composer lint",
    "lint:js": "wp-scripts lint-js src tests/js",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "format:php": "composer format",
    "format:js": "wp-scripts format src tests/js",
    "test:unit:js": "wp-scripts test-unit-js",
    "i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/od-html-toolkit wp i18n make-pot . languages/od-html-toolkit.pot --domain=od-html-toolkit --exclude=vendor,node_modules,dist,build",
    "plugin:zip": "npm run build && bash bin/build-release.sh"
  },
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.19.2"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^17.0.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/components": "^40.0.0",
    "@wordpress/compose": "^8.7.0",
    "@wordpress/data": "^10.54.0",
    "@wordpress/element": "^8.6.0",
    "@wordpress/env": "^11.14.0",
    "@wordpress/hooks": "^4.54.0",
    "@wordpress/i18n": "^6.27.0",
    "@wordpress/scripts": "^34.2.0",
    "prettier": "npm:wp-prettier@^3.0.3"
  },
  "dependencies": {
    "prettier-standalone": "npm:prettier@^3.9.6"
  }
}
